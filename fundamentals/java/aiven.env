# Copy this file to .env and replace the placeholder values.
# Keep .env local; do not commit real Kafka credentials or certificate passwords.

# ============================================
# Aiven Kafka connection
# ============================================

KAFKA_BOOTSTRAP_SERVERS=your-aiven-host:port

# SASL/PLAIN example.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG='org.apache.kafka.common.security.plain.PlainLoginModule required username="avnadmin" password="YOUR_AIVEN_PASSWORD";'

# TLS trust
KAFKA_SSL_TRUSTSTORE_LOCATION=path/to/certificates/aiven-truststore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=<your-store-pass>


# ============================================
# Kafka application
# ============================================

KAFKA_TOPIC=kafka-deep-dive.basics
KAFKA_CLIENT_ID=kafka-deep-dive-aiven
